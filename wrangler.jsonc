{
  // Must match the Worker that Cloudflare's Git integration is bound to.
  // Changing this does NOT rename the deployment — the dashboard binding
  // wins. To actually change the name, delete the Worker in the dashboard
  // and reconnect the repo under the new name, then update this.
  "name": "aftersun",
  "compatibility_date": "2026-09-01",

  // A purely static site: no server code, just the built files in dist/.
  "assets": {
    "directory": "./dist",
    // Serve our own dist/404.html for unknown URLs.
    "not_found_handling": "404-page"
  }
}
